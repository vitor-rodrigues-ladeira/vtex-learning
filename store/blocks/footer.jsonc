{
  "footer": {
    "blocks": [
      "footer-layout.desktop",
      "footer-layout.mobile"
    ]
  },
  "footer-layout.desktop": {
    "children": [
      "flex-layout.row#footer-desktop"
    ]
  },
  "footer-layout.mobile": {
    "children": [
      "flex-layout.row#footer-mobile"
    ]
  },
  "flex-layout.row#footer-desktop": {
    "props": {
      "horizontalAlign": "between",
      "blockClass": "footer-row"
    },
    "children": [
      "flex-layout.col#footer-right-wrapper"
    ]
  },
  "flex-layout.row#footer-mobile": {
    "props": {
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.col#footer-left",
      "flex-layout.col#footer-right"
    ]
  },
  "flex-layout.col#footer-right-wrapper": {
    "children": [
      "flex-layout.row#footer-columns",
      "rich-text#description"
    ]
  },
  "flex-layout.row#footer-columns": {
    "props": {
      "colSizing": "auto",
      "horizontalAlign": "between"
    },
    "children": [
      "flex-layout.col#footer-left",
      "flex-layout.col#footer-right"
    ]
  },
  "flex-layout.col#footer-left": {
    "children": [
      "rich-text#footer-left",
      "image#footer-payment-methods"
    ]
  },
  "flex-layout.col#footer-right": {
    "children": [
      "rich-text#footer-right",
      "flex-layout.row#footer-security-seals"
    ]
  },
  "rich-text#footer-left": {
    "props": {
      "text": "Formas de pagamento",
      "blockClass": "column-title"
    }
  },
  "rich-text#footer-right": {
    "props": {
      "text": "Selos de segurança",
      "blockClass": "column-title"
    }
  },
  "image#footer-payment-methods": {
    "props": {
      "src": "https://ladeira.vtexassets.com/assets/vtex.file-manager-graphql/images/82576549-f938-43d5-a8cc-f73619c05d12___40c9c6f13fc1eb2ea5e558d35835fd63.svg",
      "alt": "Formas de pagamento"
    }
  },
  "flex-layout.row#footer-security-seals": {
    "props": {
      "horizontalAlign": "left"
    },
    "children": [
      "image#footer-security-seal-1",
      "image#footer-security-seal-2",
      "image#footer-security-seal-3"
    ]
  },
  "image#footer-security-seal-1": {
    "props": {
      "src": "https://ladeira.vtexassets.com/arquivos/Group 961.png",
      "alt": "Selos de segurança"
    }
  },
  "image#footer-security-seal-2": {
    "props": {
      "src": "https://ladeira.vtexassets.com/arquivos/obit-logo.png",
      "alt": "Selos de segurança"
    }
  },
  "image#footer-security-seal-3": {
    "props": {
      "src": "https://ladeira.vtexassets.com/arquivos/lets-encrypt.png",
      "alt": "Selos de segurança"
    }
  },
  "rich-text#description": {
    "props": {
      "text": "Ladeira Comércio de Bijuterias LTDA. | CNPJ: 35.652.033/0005-24| EST THEREZA THOMAZELLA, 432 - \n GALPAO3 PAVLH A - Extrema - MG | 2022 - Todos Os Direitos Reservados .",
      "textAlignment": "CENTER",
      "blockClass": "footer-description"
    }
  }
}
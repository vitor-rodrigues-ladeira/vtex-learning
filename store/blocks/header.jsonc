{
  "header": {
    "props": {
      "blockClass": "header"
    },
    "blocks": [
      "header-layout.desktop#custom"
    ]
  },
  "header.full": {
    "props": {
      "blockClass": "header"
    },
    "blocks": [
      "header-layout.desktop#custom"
    ]
  },
  "header-layout.desktop#custom": {
    "children": [
      "flex-layout.row#header"
    ]
  },
  "flex-layout.row#header": {
    "props": {
      "blockClass": "header-container",
      "horizontalAlign": "center",
      "fullWidth": true
    },
    "children": [
      "flex-layout.row#header-content"
    ]
  },
  "flex-layout.row#header-content": {
    "props": {
      "blockClass": "header-content",
      "horizontalAlign": "center",
      "width": "15%"
    },
    "children": [
      "logo#logo"
    ]
  },
  "logo#logo": {
    "props": {
      "url": "https://ladeira.vtexassets.com/assets/vtex.file-manager-graphql/images/83ad6a4c-3df4-45b1-880f-30787a40f575___8d13b3257482c871cf9722d6c405e055.png",
      "href": "https://www.ladeiraarmarinhos.com.br/",
      "color": "#e77715",
      "blockClass": "logo",
      "width": 132,
      "height": 50,
      "mobileWidth": 90,
      "mobileHeight": 32
    }
  }
}